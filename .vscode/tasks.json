{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MiniRender: build active CMake preset",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${command:cmake.buildDirectory}"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "MiniRender: test active CMake preset",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "${command:cmake.buildDirectory}", "--output-on-failure"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
